# ClientVelo Engine — Environment Configuration
# Copy this file to .env and fill in your values before running.
# Never commit .env to version control.

# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development

# Safety: DRY_RUN=true prevents all real email sends.
# DRY_RUN must be explicitly set to false AND --send flag must be passed to send.
DRY_RUN=true

# When true, operator must confirm each batch before live sends proceed.
SEND_CONFIRMATION_REQUIRED=true

# ─── Campaign identity ────────────────────────────────────────────────────────
CAMPAIGN_ID=campaign-1
NICHE=Dental Clinic
CITY=Dhaka
COUNTRY=Bangladesh

# IANA timezone for send-window enforcement and campaign-day counting
TIMEZONE=Asia/Dhaka

# ─── Lead qualification ───────────────────────────────────────────────────────
# Minimum review count required to qualify a lead (applies only when reviewCount is present)
MIN_REVIEW_COUNT=30

# ─── Send limits ──────────────────────────────────────────────────────────────
# Hard cap per calendar day (max 20 per spec)
DAILY_SEND_LIMIT=10

# Ramp schedule: comma-separated daily caps by campaign day (1, 2, 3, ...)
# Effective cap = min(DAILY_SEND_LIMIT, RAMP_SCHEDULE[campaignDay])
RAMP_SCHEDULE=5,8,10,12,15,18,20

# Random inter-message delay (seconds) — pacing only, not a deliverability guarantee
MIN_DELAY_SECONDS=240
MAX_DELAY_SECONDS=360

# Max transient SMTP retries per message
MAX_RETRIES=2

# Advisory cooldown in days between messages to the same domain
DOMAIN_COOLDOWN_DAYS=30

# Halt sending if bounce rate exceeds this ratio (after 50+ sends)
BOUNCE_STOP_RATE=0.02

# ─── Send window ──────────────────────────────────────────────────────────────
SEND_WINDOW_START=09:00
SEND_WINDOW_END=17:00
# Comma-separated day abbreviations: Sun Mon Tue Wed Thu Fri Sat
SEND_DAYS=Sun,Mon,Tue,Wed,Thu

# ─── SMTP ─────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_APP_PASSWORD=

# ─── Sender identity (required before any live send) ─────────────────────────
FROM_NAME=
FROM_EMAIL=
REPLY_TO=
BUSINESS_NAME=
# Your physical postal address — required for CAN-SPAM compliance
POSTAL_ADDRESS=
OPT_OUT_LINE=Reply with "unsubscribe" if you would prefer not to receive messages from me.

# ─── Audit / PageSpeed Insights ───────────────────────────────────────────────
# Set to true to enable optional PSI mobile score (requires API key)
AUDIT_PSI_ENABLED=false
PAGESPEED_INSIGHTS_API_KEY=

# Thresholds for audit issue detection
LOAD_SLOW_MS=4000
PSI_POOR_SCORE=50

# ─── Playwright / Enrichment ──────────────────────────────────────────────────
MAX_PAGES_PER_DOMAIN=4
PAGE_TIMEOUT_MS=15000
PER_DOMAIN_DELAY_MS=2000

# ─── OSM / Discover ───────────────────────────────────────────────────────────
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT_SECONDS=25
MAX_DISCOVER_PER_RUN=50

# Comma-separated business names to skip (partial match, case-insensitive)
CHAIN_BLOCKLIST=

# Descriptive User-Agent sent to Overpass — update with your contact email
USER_AGENT=ClientVeloEngine/0.1 (contact: your-email@example.com)
